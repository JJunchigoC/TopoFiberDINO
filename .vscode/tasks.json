{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FiberDINO 三点三角形一键运行",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/main.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "运行项目测试",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
